# Base de datos local (levanta el contenedor con: docker compose up -d db)
DATABASE_URL=postgresql+psycopg://konyeka:konyeka@localhost:5433/konyeka

# Autenticación (genera una clave propia y larga para producción)
JWT_SECRET_KEY=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS: orígenes del frontend permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000

# Usado solo por scripts/seed_admin.py para crear el primer usuario
ADMIN_EMAIL=admin@konyeka.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador KONYEKA

# e.firma: llave simétrica (Fernet) para cifrar la llave privada y contraseña en BD.
# Genera la tuya con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EFIRMA_ENCRYPTION_KEY=

# Storage de los XML descargados. Vacío = disco local (data/blob/), útil para desarrollo.
# En Azure se usa una cadena de conexión real a Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=cfdi-xmls

# Ambiente del webservice de Descarga Masiva del SAT: PRODUCTION | TEST
SAT_ENVIRONMENT=PRODUCTION
